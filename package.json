{
  "name": "hostinger-wordpress-woocommerce-starter",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress + WooCommerce starter theme and visual feedback plugin for Hostinger deployment.",
  "scripts": {
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "wp:destroy": "wp-env destroy",
    "wp:logs": "wp-env logs",
    "wp:cli": "wp-env run cli wp",
    "build:zip": "bash scripts/build-zips.sh",
    "lint:php": "find wp-content -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "devDependencies": {
    "@wordpress/env": "latest"
  }
}
